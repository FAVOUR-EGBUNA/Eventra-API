// use prisma-next

enum UserRole {
  @@type("pg/text@1")

  ATTENDEE  = "ATTENDEE"
  ORGANIZER = "ORGANIZER"
  ADMIN     = "ADMIN"
}

enum OrganizerApprovalStatus {
  @@type("pg/text@1")

  DRAFT    = "draft"
  PENDING  = "pending"
  APPROVED = "approved"
  REJECTED = "rejected"
}

enum EventType {
  @@type("pg/text@1")

  FREE = "free"
  PAID = "paid"
}

enum EventStatus {
  @@type("pg/text@1")

  DRAFT            = "draft"
  PENDING_APPROVAL = "pending_approval"
  APPROVED         = "approved"
  REJECTED         = "rejected"
  CANCELLED        = "cancelled"
  POSTPONED        = "postponed"
}

enum OrderStatus {
  @@type("pg/text@1")

  PENDING   = "pending"
  COMPLETED = "completed"
  CANCELLED = "cancelled"
  FAILED    = "failed"
}

enum TicketStatus {
  @@type("pg/text@1")

  ACTIVE    = "active"
  USED      = "used"
  CANCELLED = "cancelled"
  REFUNDED  = "refunded"
}

model User {
  id                  Uuid     @id @default(uuid())
  fullName            String
  email               String   @unique
  phoneNumber         String?
  passwordHash        String?
  role                UserRole @default(ATTENDEE)
  isEmailVerified     Boolean  @default(false)

  verificationCode    String?
  verificationExpiry  DateTime?

  resetPasswordCode   String?
  resetPasswordExpiry DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now())

  organizerProfile OrganizerProfile?
  events           Event[]
  orders           Order[]
  tickets          Ticket[]

  @@map("users")
}

model OrganizerProfile {
  id               Uuid                    @id @default(uuid())
  userId           Uuid                    @unique

  organisationName String
  businessEmail    String?
  businessPhone    String?
  website          String?

  address          String?
  city             String?
  state            String?
  country          String?

  bankName         String?
  accountName      String?
  accountNumber    String?

  approvalStatus   OrganizerApprovalStatus @default(DRAFT)

  submittedAt      DateTime?
  reviewedAt       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("organizer_profiles")
}

model Category {
  id        Uuid    @id @default(uuid())
  name      String  @unique
  slug      String  @unique
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  events Event[]

  @@map("categories")
}

model Event {
  id           Uuid        @id @default(uuid())

  organizerId  Uuid
  categoryId   Uuid?

  title        String
  slug         String      @unique

  description  String?

  type         EventType   @default(FREE)
  status       EventStatus @default(DRAFT)

  coverImage   String?

  startDate    DateTime?
  endDate      DateTime?

  isOnline     Boolean     @default(false)

  venueName    String?
  venueAddress String?
  venueCity    String?
  venueState   String?
  venueCountry String?

  capacity     Int?

  minPrice     Float       @default(0)

  isPromoted   Boolean     @default(false)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())

  organizer  User         @relation(fields: [organizerId], references: [id])
  category   Category?    @relation(fields: [categoryId], references: [id])

  ticketTypes TicketType[]
  orders      Order[]
  tickets     Ticket[]

  @@map("events")
}

model TicketType {
  id           Uuid    @id @default(uuid())

  eventId      Uuid

  name         String
  description  String?

  price        Float   @default(0)

  quantity     Int
  quantitySold Int     @default(0)

  isActive     Boolean @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  event      Event       @relation(fields: [eventId], references: [id])
  orderItems OrderItem[]
  tickets    Ticket[]

  @@map("ticket_types")
}

model Order {
  id          Uuid        @id @default(uuid())

  userId      Uuid
  eventId     Uuid

  reference   String      @unique
  status      OrderStatus @default(PENDING)

  total       Float       @default(0)

  guestName   String?
  guestEmail  String?
  guestPhone  String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id])

  items       OrderItem[]
  tickets     Ticket[]

  @@map("orders")
}

model OrderItem {
  id           Uuid @id @default(uuid())

  orderId      Uuid
  ticketTypeId Uuid

  quantity     Int
  unitPrice    Float
  subtotal     Float

  createdAt    DateTime @default(now())

  order        Order      @relation(fields: [orderId], references: [id])
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  @@map("order_items")
}

model Ticket {
  id           Uuid         @id @default(uuid())

  userId       Uuid
  eventId      Uuid
  orderId      Uuid
  ticketTypeId Uuid

  ticketCode   String       @unique
  status       TicketStatus @default(ACTIVE)

  guestName    String?
  guestEmail   String?

  checkedInAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id])
  event        Event      @relation(fields: [eventId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id])
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  @@map("tickets")
}